# COVERLY Environment Configuration Template
# Copy to .env.local (or configure in Vercel Project Settings -> Environment Variables).
# NEVER commit real secrets, API keys, passwords, or private tokens.

# Public Frontend Configuration (Safe to expose to browser via Vite)
PUBLIC_SITE_URL=https://coverly-indol.vercel.app
VITE_API_URL=/api
VITE_INSFORGE_API_BASE=
VITE_INSFORGE_ANON_KEY=

# Backend & Serverless Configuration (Server-Side Only — NEVER prefix with VITE_)
PORT=5000
CORS_ORIGIN=https://coverly-indol.vercel.app
INSFORGE_PROJECT_URL=
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
INSFORGE_SERVICE_ROLE_KEY=

# Optional Database / Auth / Email / Integration Secrets (Server-Side Only)
DATABASE_URL=
JWT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
