# COVERLY Environment Configuration Template
# Copy to .env.local (or configure in Vercel Project Settings -> Environment Variables).
# NEVER commit real secrets, API keys, passwords, or private tokens.

# Public Frontend Configuration (Safe to expose to browser via Vite)
PUBLIC_SITE_URL=https://coverly-indol.vercel.app
VITE_API_URL=/api
VITE_INSFORGE_API_BASE=
VITE_INSFORGE_ANON_KEY=

# Backend & Serverless Configuration (Server-Side Only — NEVER prefix with VITE_)
PORT=5000
CORS_ORIGIN=https://coverly-indol.vercel.app
INSFORGE_PROJECT_URL=
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
INSFORGE_SERVICE_ROLE_KEY=

# Optional Database / Auth / Email / Integration Secrets (Server-Side Only)
DATABASE_URL=
JWT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ============================================================================
# Payment Gateway Credentials (Server-Side Only — NEVER expose via VITE_*)
# Keep all gateways in sandbox mode until merchant accounts & webhooks are verified.
# ============================================================================

# 1. Cashfree Payments (PG API v2023-08-01)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_SECRET=

# 2. Razorpay (REST API v1 — rzp_test_* for sandbox, rzp_live_* for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 3. PayU India (Hosted Checkout + Postservice API v2)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=sandbox
PAYU_WEBHOOK_SECRET=

# 4. Paytm for Business (All-in-One Payment Gateway)
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_ENVIRONMENT=sandbox
