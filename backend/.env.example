# Server port for local development
PORT=5000

# Allowed frontend origin(s), comma-separated (leave * for open CORS or set your Vercel frontend URL)
CORS_ORIGIN=*

# InsForge Backend Credentials
# Base URL of your InsForge project (e.g. https://your-project-id.us-east.insforge.app)
INSFORGE_BASE_URL=

# InsForge Public Anon Key
INSFORGE_ANON_KEY=

# InsForge Server/Admin API Key (optional, used for privileged backend DB writes if RLS is enabled)
INSFORGE_API_KEY=
