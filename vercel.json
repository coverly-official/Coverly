{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/og-image.ts": {
      "includeFiles": "api/_assets/**"
    }
  },
  "headers": [
    {
      "source": "/categories/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/og-image",
      "destination": "/api/og-image"
    },
    {
      "source": "/api/render",
      "destination": "/api/render"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/((?!og-image(?:/|$)|render(?:/|$)|sitemap(?:/|$)).*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|og(?:/|$)|categories/[^/]+\\.(?:jpg|jpeg|png|webp|svg)$|robots\\.txt$|sitemap\\.xml$|[^/]+\\.[^/]+$).*)",
      "destination": "/api/render?__path=/$1"
    }
  ]
}
